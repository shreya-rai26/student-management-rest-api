{
  "info": {
    "_postman_id": "f5e7c0aa-9d1c-4a0c-9b3a-student-api",
    "name": "Student Management REST API",
    "description": "Postman collection for Module 3 Practical 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "studentId",
      "value": "101"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Get All Students",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/students"
      }
    },
    {
      "name": "Get Student By ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/students/{{studentId}}"
      }
    },
    {
      "name": "Create Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id\": 104,\n  \"name\": \"Shreya Rai\",\n  \"email\": \"shreya@example.com\",\n  \"department\": \"CSE\",\n  \"semester\": 5,\n  \"cgpa\": 8.70\n}"
        },
        "url": "{{baseUrl}}/students"
      }
    },
    {
      "name": "Update Student",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Shreya Rai Updated\",\n  \"email\": \"shreya.updated@example.com\",\n  \"department\": \"CSE\",\n  \"semester\": 6,\n  \"cgpa\": 9.00\n}"
        },
        "url": "{{baseUrl}}/students/{{studentId}}"
      }
    },
    {
      "name": "Search By Department",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/students/department/CSE"
      }
    },
    {
      "name": "Delete Student",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/students/{{studentId}}"
      }
    },
    {
      "name": "Duplicate Email Test",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id\": 105,\n  \"name\": \"Duplicate Test\",\n  \"email\": \"aarav@example.com\",\n  \"department\": \"CSE\",\n  \"semester\": 5,\n  \"cgpa\": 8.00\n}"
        },
        "url": "{{baseUrl}}/students"
      }
    }
  ]
}